<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude generated code (anonymous/inner classes) -->
    <Match>
        <Class name="~.*\$.*"/>
    </Match>

    <!-- Lombok generated methods -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~.*\.schema\.model\..*"/>
    </Match>

    <!--
      Inspector DTO carrier (record): Inspection holds result lists. Same immutable
      data-holder pattern as schema.model — defensive copies would add noise without value.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="com.datagenerator.inspector.Inspection"/>
    </Match>

    <!--
      Test and integration test classes: suppress low-signal patterns that are
      standard JUnit idioms or safe-by-design in test contexts.

      THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION  — JUnit 5 allows 'throws Exception'; no value in tightening test signatures
      THROWS_METHOD_THROWS_RUNTIMEEXCEPTION        — test helpers intentionally throw unchecked exceptions
      RV_RETURN_VALUE_IGNORED_BAD_PRACTICE         — Future/FutureTask from ExecutorService.submit() in tests; synchronisation is external
      RV_RETURN_VALUE_IGNORED                      — same, relaxed variant
      SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE     — test DDL/DML is hard-coded and not user-controlled
      DMI_EMPTY_DB_PASSWORD                        — test databases use well-known credentials; not a production concern
      NM_CONFUSING                                 — setUp/setup naming across unrelated test classes is harmless
      UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR     — @BeforeEach / @Setup initialise fields; SpotBugs cannot see JUnit lifecycle
      BX_UNBOXING_IMMEDIATELY_REBOXED              — test assertion / comparison idiom; readability > micro-optimisation
      ICAST_INTEGER_MULTIPLY_CAST_TO_LONG          — test data arithmetic; no risk of production overflow
      DM_DEFAULT_ENCODING                          — test output / string helpers use platform encoding harmlessly
    -->
    <!--
      AvroSerializer uses double-checked locking (DCL) for lazy schema initialization.
      schema and datumWriter are always set together in ensureInitialized() before any
      dereference. Schema is effectively immutable after Avro creates it (EI_EXPOSE_REP).
    -->
    <Match>
        <Class name="com.datagenerator.formats.avro.AvroSerializer"/>
        <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR,EI_EXPOSE_REP"/>
    </Match>

    <!--
      FileDestination: outputStream and streamWriter are initialized in open() for non-Avro formats.
      All access sites are guarded by the isAvro branch; SpotBugs cannot track this invariant.
    -->
    <Match>
        <Class name="com.datagenerator.destinations.file.FileDestination"/>
        <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
    </Match>

    <Match>
        <Class name="~.*(Test|IT|Benchmark).*"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION,
                      THROWS_METHOD_THROWS_RUNTIMEEXCEPTION,
                      RV_RETURN_VALUE_IGNORED_BAD_PRACTICE,
                      RV_RETURN_VALUE_IGNORED,
                      SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE,
                      DMI_EMPTY_DB_PASSWORD,
                      NM_CONFUSING,
                      UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR,
                      BX_UNBOXING_IMMEDIATELY_REBOXED,
                      ICAST_INTEGER_MULTIPLY_CAST_TO_LONG,
                      DM_DEFAULT_ENCODING,
                      DE_MIGHT_IGNORE,
                      REC_CATCH_EXCEPTION,
                      CNT_ROUGH_CONSTANT_VALUE,
                      OBL_UNSATISFIED_OBLIGATION,
                      ODR_OPEN_DATABASE_RESOURCE"/>
    </Match>

    <!--
      FindSecBugs (security patterns, also run by Codacy)

      PREDICTABLE_RANDOM — java.util.Random seeded per record IS the product: deterministic,
      reproducible test data. Nothing generated here is a secret or a security token.
    -->
    <Match>
        <Bug pattern="PREDICTABLE_RANDOM"/>
    </Match>

    <!--
      Test code and test support classes (CliTestSupport, PostgresE2ESupport, ...):
      HARD_CODE_PASSWORD                — fake credentials / config key names in fixtures
      OVERLY_PERMISSIVE_FILE_PERMISSION — tests set 644/666 on purpose to prove the checks reject them
      UNENCRYPTED_SERVER_SOCKET         — loopback-only sockets/servers used as test doubles
      SQL_INJECTION_JDBC                — hard-coded DDL/DML against throwaway test databases
    -->
    <Match>
        <Class name="~.*(Test|IT|Benchmark|Support).*"/>
        <Bug pattern="HARD_CODE_PASSWORD,
                      OVERLY_PERMISSIVE_FILE_PERMISSION,
                      UNENCRYPTED_SERVER_SOCKET,
                      SQL_INJECTION_JDBC"/>
    </Match>

    <!--
      IMPROPER_UNICODE — every case mapping/equalsIgnoreCase in main code compares ASCII keywords or
      identifiers (format names, URI schemes, SQL keywords/identifiers) and already uses
      Locale.ROOT; none is a security decision on user-controlled Unicode text.
      CRLF_INJECTION_LOGS — logged values come from the operator's own job/structure files and CLI
      arguments; output is a console/file log for that same operator, not a parsed security log.
    -->
    <Match>
        <Bug pattern="IMPROPER_UNICODE,CRLF_INJECTION_LOGS"/>
    </Match>

    <!--
      REDOS — anchored, linear patterns (no nested/overlapping quantifiers) over short config
      strings: TypeParser unique[...] / ref[..., unique] syntax and DdlInspector's inline
      REFERENCES clause.
    -->
    <Match>
        <Or>
            <Class name="com.datagenerator.core.type.TypeParser"/>
            <Class name="com.datagenerator.inspector.ddl.DdlInspector"/>
        </Or>
        <Bug pattern="REDOS"/>
    </Match>

    <!--
      PATH_TRAVERSAL_IN — structures_path comes from the operator's own job file; reading
      structures from an arbitrary operator-chosen directory is the feature.
    -->
    <Match>
        <Class name="com.datagenerator.cli.ExecuteCommand"/>
        <Method name="call"/>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>
</FindBugsFilter>
